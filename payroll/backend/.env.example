APP_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
PASSWORD_VAULT_KEY=replace-with-a-fernet-key-generated-once-and-kept-secret
ALLOWED_ORIGINS=https://payroll.example.go.th
TRUSTED_HOSTS=payroll.example.go.th

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
